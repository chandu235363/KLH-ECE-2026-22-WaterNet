# PostgreSQL database settings
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/waternet
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-me
PGDATABASE=waternet

# Backend API settings
PORT=8000
JWT_SECRET=replace-this-with-a-long-random-secret

# Simulator settings
API_BASE=http://localhost:8000
SIM_INTERVAL_SECONDS=5
SIM_ANOMALY_CHANCE=0.05

# Frontend API setting
VITE_API_BASE=http://localhost:8000
